{
  "name": "discord-holdem",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-07",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "keep_vars": true,
  // The shared character profile is maintained directly in the Cloudflare dashboard.
  "vars": {
    "GEMINI_API_BASE_URL": "https://gcli.ggchan.dev/v1",
    "GEMINI_MODEL": "build-gemini-3.8-flash"
  },
  "durable_objects": {"bindings": [{"name": "TABLES", "class_name": "PokerTable"}]},
  "d1_databases": [{"binding": "CHAT_DB", "database_name": "aliceneko-ai", "database_id": "b9327b3d-b549-4c48-b221-689c5f4aa3a9"}],
  // Production PokerTable namespace already exists; retain v1 without recreating it.
  // For a fresh Worker installation, v1 must include new_sqlite_classes: ["PokerTable"].
  "migrations": [{"tag": "v1"}],
  "triggers": {"crons": ["* * * * *"]},
  "observability": {"enabled": true,"head_sampling_rate": 1,"logs":{"enabled":true,"invocation_logs":true,"persist":true}}
}
